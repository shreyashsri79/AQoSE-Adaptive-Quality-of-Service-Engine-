flowchart TB
    R(["RED connection<br/>a video call starts"]):::red
    B(["BLUE connection<br/>a cloud backup starts"]):::blue
    C["Classifier<br/>first 8 packet headers<br/>259 trees, about 6 µs"]
    R --> C
    B --> C
    C --> PR["RED odds<br/>video call 75%<br/>voice call 20%<br/>streaming 5%"]:::red
    C --> PB["BLUE odds<br/>background transfer 85%<br/>download 10%<br/>video call 5%"]:::blue
    PR --> ER["Odds × measured harm, per lane<br/>Voice 1.13, barred: not a call or game<br/>Video 0.05, lowest<br/>Best Effort 1.53<br/>Bulk 1.95"]:::red
    PB --> EB["Odds × measured harm, per lane<br/>Voice 1.83, barred<br/>Video 2.15<br/>Best Effort 1.38<br/>Bulk 0.83, lowest"]:::blue
    subgraph CAKE["CAKE"]
        direction LR
        VO["VOICE<br/>priority up to 25% of the line"]
        VI["VIDEO<br/>priority up to 50%"]
        BE["BEST EFFORT<br/>up to 100%"]
        BU["BULK<br/>kept at least 6.25%"]
    end
    ER ==>|"100% of RED's packets"| VI
    EB ==>|"first 8 packets: 100% of BLUE,<br/>the guard waits for more evidence"| BE
    EB ==>|"seconds later, over 80% sure and TCP:<br/>100% of BLUE"| BU
